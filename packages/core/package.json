{
  "name": "@twinscape/core",
  "version": "0.1.0",
  "description": "Framework-agnostic Three.js digital twin viewer core",
  "license": "MIT",
  "author": "Lin",
  "homepage": "https://github.com/guyue625/twinscape#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guyue625/twinscape.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/guyue625/twinscape/issues"
  },
  "keywords": [
    "three",
    "threejs",
    "digital-twin",
    "3d",
    "webgl",
    "viewer",
    "gltf",
    "glb"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "three": "^0.185.0"
  },
  "dependencies": {
    "@types/three": "0.185.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "jsdom": "26.1.0",
    "three": "0.185.0",
    "tsup": "8.5.0",
    "vitest": "3.2.4"
  }
}
